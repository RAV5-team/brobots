# Скопируйте в .env.local (в git не попадает) и заполните для демо-сборки.
# Vite отдаёт в браузер только переменные с префиксом VITE_ и подставляет их при сборке.

# Демо-сборка (D-16): ?as=guest|user|admin и плашки демо-доступов на экране входа 05.
VITE_DEMO_MODE=false

# Демо-учётки жюри (ТЗ 8.2.5, PRD 4). Читаются только при VITE_DEMO_MODE=true.
VITE_DEMO_USER_EMAIL=
VITE_DEMO_USER_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=

# Ссылка «Публичный сайт RAV5» на экране входа (D-28). Пусто — главная приложения.
VITE_PUBLIC_SITE_URL=
