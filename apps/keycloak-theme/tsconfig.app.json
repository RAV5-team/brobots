{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "vitest/globals"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    // Файлы apps/web берут зависимости отсюда (как resolve.dedupe в vite.config.ts): node_modules apps/web не нужны.
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["../web/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-router": ["./node_modules/react-router"],
      "clsx": ["./node_modules/clsx"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@radix-ui/react-checkbox": ["./node_modules/@radix-ui/react-checkbox"]
    }
  },
  "include": ["src", "../web/src/vite-env.d.ts"]
}
