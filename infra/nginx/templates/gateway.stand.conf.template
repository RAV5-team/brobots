# Профиль stand: https://${PUBLIC_HOST}. TLS терминируется здесь, HSTS включается
# автоматически через map $scheme $hsts.
include /etc/nginx/snippets/http-common.conf;

server {
    listen 80 default_server;
    server_name _;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    location ^~ /auth/admin/ {
        allow ${ADMIN_ALLOW_CIDR};
        deny all;
        include /etc/nginx/snippets/proxy-headers.conf;
        add_header Strict-Transport-Security $hsts always;
        proxy_pass http://kc;
    }
    location ^~ /auth/realms/master/ {
        allow ${ADMIN_ALLOW_CIDR};
        deny all;
        include /etc/nginx/snippets/proxy-headers.conf;
        add_header Strict-Transport-Security $hsts always;
        proxy_pass http://kc;
    }

    include /etc/nginx/snippets/keycloak.conf;
    location / { return 404; }
}
