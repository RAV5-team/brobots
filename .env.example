# Скопируйте в .env и поменяйте значения: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- Postgres ---
POSTGRES_USER=brobots
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=brobots
POSTGRES_PORT=5432

# --- Порты на хосте ---
API_PORT=8000
SIMULATION_PORT=8001
ECONOMICS_PORT=8002
# Хост-порт Vite в режиме разработки.
WEB_PORT=5173
# Хост-порт nginx с собранным фронтендом в проде.
WEB_PUBLIC_PORT=8080

# --- Общее ---
# debug | info | warn | error
LOG_LEVEL=info
# local | staging | production
APP_ENV=local

# --- Фронтенд (Vite: переменные обязаны начинаться с VITE_) ---
# Пусто = относительные пути через прокси dev-сервера / nginx. Так нет CORS.
VITE_API_BASE_URL=
