# Рабочие значения для профиля local: cp .env.example .env && docker compose up -d --build
# Для stand: ./scripts/gen-secrets.sh (секреты) + PUBLIC_URL/PUBLIC_HOST/ADMIN_ALLOW_CIDR вручную.
# Не используйте `$` в значениях: Compose воспримет его как подстановку.
#
# PUBLIC_URL зашивается в realm при первом импорте (iss, redirect URI). После смены —
# `docker compose down -v`. Порт в PUBLIC_URL обязан совпадать с GATEWAY_PORT:
# GATEWAY_PORT=8080 -> PUBLIC_URL=http://localhost:8080.
# Открывать по IP машины (http://192.168.x.x) нельзя: вход (PKCE) работает только на https или localhost.

# --- Шлюз ---
PUBLIC_URL=http://localhost
PUBLIC_HOST=localhost
GATEWAY_PORT=80
# Кому доступна админка Keycloak (/auth/admin/). В stand — адрес команды, например 203.0.113.10/32.
ADMIN_ALLOW_CIDR=0.0.0.0/0

# --- Postgres ---
# Суперпользователь — только для администрирования.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rav5-local-pg-2f7c1a
# Роль-владелец БД keycloak.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=rav5-local-kcdb-9d41e0

# --- Keycloak ---
# Администратор master-realm Keycloak (не платформы!): http://localhost/auth/admin/
KC_ADMIN_USERNAME=kcadmin
KC_ADMIN_PASSWORD=rav5-local-kcadmin-5b8e36
# Секрет конфиденциального клиента rav5-api-internal (client credentials).
KC_API_INTERNAL_SECRET=rav5-local-internal-7a3f9c2e41d8b605

# --- Демо-учётки realm rav5 (дублируются в README) ---
# user@example.com / admin@example.com
DEMO_USER_PASSWORD=DemoUser2026
DEMO_ADMIN_PASSWORD=DemoAdmin2026
