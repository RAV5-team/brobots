# Рабочие значения для профиля local: cp .env.example .env && docker compose up -d --build
# Для stand: ./scripts/gen-secrets.sh (секреты) + PUBLIC_URL/PUBLIC_HOST/ADMIN_ALLOW_CIDR вручную.
# Не используйте `$` в значениях: Compose воспримет его как подстановку.
#
# PUBLIC_URL зашивается в realm при первом импорте (iss, redirect URI). После смены —
# `docker compose down -v`. Порт в PUBLIC_URL обязан совпадать с GATEWAY_PORT:
# GATEWAY_PORT=8080 -> PUBLIC_URL=http://localhost:8080.
# Открывать по IP машины (http://192.168.x.x) нельзя: вход (PKCE) работает только на https или localhost.

# --- Шлюз ---
PUBLIC_URL=http://localhost
PUBLIC_HOST=localhost
GATEWAY_PORT=80
# Кому доступна админка Keycloak (/auth/admin/). В stand — адрес команды, например 203.0.113.10/32.
ADMIN_ALLOW_CIDR=0.0.0.0/0

# --- Postgres ---
# Суперпользователь — только для администрирования.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rav5-local-pg-2f7c1a
# Роль-владелец БД keycloak.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=rav5-local-kcdb-9d41e0
# Роль-владелец БД api.
API_DB_USERNAME=api
API_DB_PASSWORD=rav5-local-apidb-4c2e87
# Роль-владелец БД simulation.
SIM_DB_USERNAME=simulation
SIM_DB_PASSWORD=rav5-local-simdb-b1d63f
# Роль-владелец БД economics.
ECON_DB_USERNAME=economics
ECON_DB_PASSWORD=rav5-local-econdb-a142b7

# --- Keycloak ---
# Администратор master-realm Keycloak (не платформы!): http://localhost/auth/admin/
KC_ADMIN_USERNAME=kcadmin
KC_ADMIN_PASSWORD=rav5-local-kcadmin-5b8e36
# Секрет конфиденциального клиента rav5-api-internal (client credentials).
KC_API_INTERNAL_SECRET=rav5-local-internal-7a3f9c2e41d8b605

# --- Сервис api ---
# Порт api на хосте.
API_PORT=8000
# Применять миграции при старте.
API_MIGRATE_ON_START=true
# Загрузить демо-данные (каталог ФЦ БАС, процессы, демо-локации). Повторный запуск ничего не дублирует.
API_SEED_DEMO=true
# Swagger UI на /docs.
API_SWAGGER_ENABLED=true
# Калькуляция парка и экономики (docs/orchestrator.md). Пусто — встроенная мок-модель mock-calc/v1;
# адрес сервиса economics, например http://economics:8002, — расчёт по его контракту.
ECONOMICS_URL=
# Предел ожидания ответа economics (норматив ТЗ на экономику — 10 с).
ECONOMICS_TIMEOUT=10s

# --- Сервис simulation ---
# Порт на хосте: API и экран шага, http://localhost:8765
SIMULATION_PORT=8765
# Воркеров заданий в процессе сервера; 0 — только API.
SIM_WORKERS=1

# --- Сервис economics ---
# Порт economics не публикуется на хост; доступ разрешён только из Docker internal.
ECONOMIC_SERVICE_ENV=development

# --- Фронтенд (Vite: переменные обязаны начинаться с VITE_) ---
# Пусто = относительные пути через прокси dev-сервера / nginx. Так нет CORS.
VITE_API_BASE_URL=
# --- Демо-учётки realm rav5 (дублируются в README) ---
# user@example.com / admin@example.com
DEMO_USER_PASSWORD=DemoUser2026
DEMO_ADMIN_PASSWORD=DemoAdmin2026

# TODO(dev-auth): dev-режим api и simulation для ручного тестирования без токенов (только local).
# Запросы без Authorization идут от AUTH_DEV_SUB (UUID) с ролями AUTH_DEV_ROLES;
# заголовок X-Dev-User: <uuid> подменяет пользователя. Удалить вместе с dev-режимом.
AUTH_DEV_MODE=false
# AUTH_DEV_SUB=11111111-1111-4111-8111-111111111111
# AUTH_DEV_ROLES=user,admin
